# Dev-only files: deployed by accident, never used by the site.
# Keeps deployment size (and Vercel's per-push storage) down.

# Local tooling
scripts/
.gitignore

# Credentials — Vercel ignores this by default, but be explicit
.env.local
.env*.local

# Database schema, applied once by hand in the Supabase dashboard
supabase-v20.sql

# Vercel CLI metadata
.vercel/