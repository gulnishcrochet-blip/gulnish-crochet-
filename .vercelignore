# Dev-only files: the deploy uploads the site, not the local toolchain.
# Each of these was shipped on every one of the 1200+ deployments for nothing.
scripts/
supabase-v20.sql
.gitignore
.gitattributes
*.md

# Never upload local env files. `vercel link` writes a .env.local holding a
# VERCEL_OIDC_TOKEN into the project root, and a root file is published as a
# static asset - without this it would be readable at /.env.local.
.env*
.vercel/
